# DeepSeek 配置示意。复制为 .env 后填写；不要在本文件写入真实 Key。
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# disabled 最稳妥；enabled 会保留并回传 reasoning_content。
LLM_THINKING=disabled

# 自定义兼容 Chat Completions 的服务：设置 LLM_PROVIDER=custom，
# 修改 LLM_BASE_URL 和 LLM_MODEL，并配置下面的独立密钥。
# LLM_API_KEY=your-custom-service-key
# 本地 Ollama 可直接用 --provider ollama --select-model，无需 Key。
# 远程 Ollama 需设置 OLLAMA_API_KEY，并通过 --base-url 指定地址。
